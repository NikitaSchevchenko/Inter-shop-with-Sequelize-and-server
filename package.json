{
  "name": "inter-shop-with-sequelize-and-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon index.js",
    "init-db": "npx dotenv-cli -- bash -c 'npx sequelize-auto -h \"$DB_HOST\" -p \"$DB_PORT\" -d \"$DB_NAME\" -u \"$DB_USERNAME\" -x \"$DB_PASSWORD\" -e postgres --cm p --sg true -o ./src/db/models'",
    "dbCreate": "npx sequelize-cli db:create",
    "dbDrop": "npx sequelize-cli db:drop",
    "migAll": "npx sequelize-cli db:migrate",
    "migUn": "npx sequelize-cli db:migrate:undo",
    "migUnAll": "npx sequelize-cli db:migrate:undo:all",
    "seedAll": "npx sequelize-cli db:seed:all",
    "seedUn": "npx sequelize-cli db:seed:undo",
    "seedUnAll": "npx sequelize-cli db:seed:undo:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-auto": "^0.8.8",
    "sequelize-cli": "^6.6.5"
  }
}
